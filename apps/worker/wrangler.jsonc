{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "engagement-tool",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/o/*", "/healthz"]
  },
  // Invocation logs record full URLs, and overlay URLs carry bearer tokens (ADR-007).
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    }
  },
  // Retention every 6 hours, so season end plus cleanup lag stays well inside 30 days (docs/design/07-infrastructure.md).
  "triggers": { "crons": ["0 */6 * * *"] },
  "durable_objects": {
    "bindings": [
      { "name": "LIVE_SESSION", "class_name": "LiveSession" },
      { "name": "QUOTA", "class_name": "QuotaKeeper" }
    ]
  },
  // The free plan only allows SQLite-backed Durable Objects.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LiveSession", "QuotaKeeper"] }],
  // Non-secret values only; secrets go through `wrangler secret put` (docs/SETUP.md).
  "vars": {
    "APP_ENV": "production",
    "SESSIONS_DISABLED": "false",
    "QUOTA_PROJECT_DAILY": "9000",
    "QUOTA_WORKSPACE_DAILY": "3000",
    "DEMO_STARTS_DAILY": "4"
  }
}
